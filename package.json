{
  "name": "lulune-autoclicker",
  "version": "1.4.1",
  "description": "LuLune AutoClicker - advanced cross-platform autoclicker (Windows, macOS, Linux)",
  "main": "main.js",
  "author": "LuLune",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . LuLuneAutoClicker --platform=win32 --arch=x64 --out=dist --overwrite --asar --win32metadata.CompanyName=LuLune --win32metadata.FileDescription=LuLune AutoClicker --win32metadata.ProductName=LuLune AutoClicker --win32metadata.InternalName=LuLuneAutoClicker --win32metadata.OriginalFilename=LuLuneAutoClicker.exe && node scripts/postpackage.js win",
    "package:mac": "electron-packager . LuLuneAutoClicker --platform=darwin --arch=x64 --out=dist --overwrite --asar --app-bundle-id=com.lulune.autoclicker --app-category-type=public.app-category.utilities && node scripts/postpackage.js mac",
    "package:mac:arm64": "electron-packager . LuLuneAutoClicker --platform=darwin --arch=arm64 --out=dist --overwrite --asar --app-bundle-id=com.lulune.autoclicker --app-category-type=public.app-category.utilities && node scripts/postpackage.js mac",
    "package:linux": "electron-packager . LuLuneAutoClicker --platform=linux --arch=x64 --out=dist --overwrite --asar && node scripts/postpackage.js linux",
    "package:linux:arm64": "electron-packager . LuLuneAutoClicker --platform=linux --arch=arm64 --out=dist --overwrite --asar && node scripts/postpackage.js linux",
    "package:all": "npm run package:win && npm run package:mac && npm run package:linux",
    "zip:downloads": "node scripts/zip-downloads.js",
    "dist:win": "electron-builder --win nsis zip --publish never && node scripts/copy-setup.js",
    "dist:mac": "electron-builder --mac dmg zip --publish never && node scripts/copy-setup.js",
    "dist:linux": "electron-builder --linux AppImage zip --publish never && node scripts/copy-setup.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6",
    "discord-rpc": "^4.0.1",
    "uiohook-napi": "^1.5.5"
  },
  "overrides": {
    "register-scheme": "0.0.2"
  },
  "build": {
    "appId": "com.lulune.autoclicker",
    "productName": "LuLune AutoClicker",
    "copyright": "LuLune",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "**/*",
      "!dist/**",
      "!release/**",
      "!website/**",
      "!.ci-artifacts/**",
      "!**/*.zip",
      "!**/*.md"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/uiohook-napi/**",
      "node_modules/@nut-tree-fork/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lulunee19",
        "repo": "LuLune-Auto-Clicker"
      }
    ],
    "win": {
      "executableName": "LuLuneAutoClicker",
      "signAndEditExecutable": false,
      "artifactName": "LuLuneAutoClicker-Windows.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuLune AutoClicker",
      "uninstallDisplayName": "LuLune AutoClicker",
      "artifactName": "LuLuneAutoClicker-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "LuLuneAutoClicker-macOS-${arch}.${ext}"
    },
    "dmg": {
      "title": "LuLune AutoClicker"
    },
    "linux": {
      "category": "Utility",
      "executableName": "LuLuneAutoClicker",
      "synopsis": "LuLune AutoClicker",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LuLuneAutoClicker-Linux.${ext}"
    }
  }
}
